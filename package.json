{
  "name": "accessible-table-ocr-check",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare:api": "npm ci --prefix api --ignore-scripts",
    "build": "npm run prepare:api && tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/*.test.ts && playwright test",
    "test:unit": "vitest run tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:live": "PLAYWRIGHT_BASE_URL=https://accessible-table-ocr-check.sociobot.in playwright test",
    "test:claims": "vitest run tests/*.test.ts --testNamePattern @claim: && playwright test --project=chromium --grep @claim:",
    "refresh:billing-fixture": "node scripts/refresh-billing-fixture.mjs",
    "test:live-rate-limit": "node scripts/verify-live-rate-limit.mjs --concurrent",
    "test:live-rate-limit:sequential": "node scripts/verify-live-rate-limit.mjs --sequential"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@types/node": "24.3.0",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "overrides": {
    "playwright-core": "1.58.2"
  }
}
